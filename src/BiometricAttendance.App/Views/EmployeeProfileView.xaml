<UserControl x:Class="BiometricAttendance.App.Views.EmployeeProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BiometricAttendance.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:EmployeeProfileViewModel}">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="30,20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="← Back" Command="{Binding GoBackCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,20,0" VerticalAlignment="Center" Cursor="Hand" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Employee.FullName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" />
                    <TextBlock Text="{Binding Employee.EmployeeCode, StringFormat='Code: {0}'}" FontSize="14" Foreground="{DynamicResource MutedTextColor}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Edit" Command="{Binding EditEmployeeCommand}" Visibility="{Binding CanEditEmployee, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="16,8" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" BorderThickness="1" BorderBrush="{DynamicResource PrimaryColor}" Cursor="Hand" />
                    <Button Content="Archive" Command="{Binding ArchiveEmployeeCommand}" Visibility="{Binding CanArchiveEmployee, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="16,8" Background="Transparent" Foreground="Red" BorderThickness="1" BorderBrush="Red" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Personal Info -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Personal Information" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Birth Date" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Employee.BirthDate}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gender" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Employee.Gender}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Employee.Phone}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Email" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Employee.Email}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Address" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Employee.Address}"/>
                    </Grid>
                </StackPanel>

                <!-- Employment Info -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Employment Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Department" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Employee.Department.Name}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Employee.Position.Name}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Employee.EmploymentType}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Date Hired" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Employee.DateHired}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Employee.EmploymentStatus}"/>
                        
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Overtime Eligible" Foreground="{DynamicResource MutedTextColor}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Employee.IsOvertimeEligible}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
