<Window x:Class="BiometricAttendance.App.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BiometricAttendance.App.ViewModels"
        Title="Biometric Attendance System — Sign In"
        Width="420" Height="560"
        MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontInter}">

    <Grid>
        <!-- Two-column layout: decorative left + form right -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>  <!-- reserved for future left panel / logo -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main login card -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="0"
                Padding="40,48">
            <StackPanel VerticalAlignment="Center">

                <!-- Logo / Brand -->
                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="14"
                        Width="56" Height="56"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20">
                    <TextBlock Text="B"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Welcome back"
                           Style="{StaticResource TextH2}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to Biometric Attendance System"
                           Style="{StaticResource TextMuted}"
                           Margin="0,0,0,32"/>

                <!-- Error Message -->
                <Border x:Name="ErrorBanner"
                        Background="#FFF5F5"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="0,0,0,3"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource TextBodySm}" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource TextBodySm}" FontWeight="Medium" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTextBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- Show/hide toggle -->
                    <Button Style="{StaticResource ButtonIcon}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            ToolTip="Show/hide password">
                        <TextBlock Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToEyeIcon}}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                </Grid>

                <TextBlock Text="Forgot password? Contact your administrator."
                           Style="{StaticResource TextMuted}"
                           Margin="0,0,0,28"/>

                <!-- Sign In Button -->
                <Button Content="{Binding IsLoading, Converter={StaticResource LoadingToText}, ConverterParameter='Signing in...|Sign In'}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        HorizontalAlignment="Stretch"/>

                <!-- Version info -->
                <TextBlock Text="Biometric Attendance v1.0 — Phase 1"
                           Style="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
