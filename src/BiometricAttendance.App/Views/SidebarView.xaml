<UserControl x:Class="BiometricAttendance.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BiometricAttendance.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Brand header -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation -->
            <RowDefinition Height="*"/>
            <!-- Footer (user info) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <Border Grid.Row="0" Padding="20,24,20,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}"
                        CornerRadius="10"
                        Width="36" Height="36"
                        Margin="0,0,10,0">
                    <TextBlock Text="B"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="ExtraBold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Biometric"
                               Foreground="{StaticResource TextLightBrush}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeBase}"/>
                    <TextBlock Text="Attendance System"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="{StaticResource FontSizeXs}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Navigation Items -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="12,8">

                <!-- Main nav items -->
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ButtonIcon}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Width="24"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           FontSize="{StaticResource FontSizeBase}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator -->
                <Border Height="1" Background="#40FFFFFF" Margin="12,12"/>

                <!-- Admin nav items -->
                <ItemsControl ItemsSource="{Binding AdminNavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Width="24"
                                                           FontSize="15"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="#30FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <TextBlock Text="v1.0 — Phase 1"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="{StaticResource FontSizeXs}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
