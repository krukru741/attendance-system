<Window x:Class="BiometricAttendance.App.Views.AddEmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BiometricAttendance.App.ViewModels"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        d:DataContext="{d:DesignInstance Type=vm:AddEmployeeViewModel}">
    
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stepper Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Step 1: Personal" FontWeight="{Binding CurrentStep, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=1}" Margin="0,0,10,0"/>
            <TextBlock Text=">" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,10,0"/>
            <TextBlock Text="Step 2: Employment" FontWeight="{Binding CurrentStep, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=2}" Margin="0,0,10,0"/>
            <TextBlock Text=">" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,10,0"/>
            <TextBlock Text="Step 3: Settings" FontWeight="{Binding CurrentStep, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=3}" Margin="0,0,10,0"/>
            <TextBlock Text=">" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,10,0"/>
            <TextBlock Text="Step 4: Summary" FontWeight="{Binding CurrentStep, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=4}"/>
        </StackPanel>

        <!-- Step 1: Personal -->
        <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="First Name *" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FirstName}" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Last Name *" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LastName}" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Birth Date" Margin="0,0,0,4"/>
                    <!-- WPF doesn't have a built-in DateOnly picker, so we use string binding for simplicity or a custom converter. For now, simple text box or DatePicker -->
                    <DatePicker SelectedDate="{Binding BirthDate, Converter={StaticResource DateOnlyToDateTimeConverter}}" Margin="0,0,0,12"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Middle Name" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MiddleName}" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Suffix (e.g. Jr.)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Suffix}" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Gender" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" Padding="8" Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Email Address" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email}" Padding="8" Margin="0,0,0,12"/>
            <TextBlock Text="Phone Number" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Phone}" Padding="8" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Step 2: Employment -->
        <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
            <TextBlock Text="Employee Code *" Margin="0,0,0,4"/>
            <TextBox Text="{Binding EmployeeCode}" Padding="8" Margin="0,0,0,12"/>
            
            <TextBlock Text="Department" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DisplayMemberPath="Name" Padding="8" Margin="0,0,0,12"/>
            
            <TextBlock Text="Position" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}" DisplayMemberPath="Name" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Employment Type" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding EmploymentTypes}" SelectedItem="{Binding EmploymentType}" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Date Hired" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding DateHired, Converter={StaticResource DateOnlyToDateTimeConverter}}" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Step 3: Settings -->
        <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=3}">
            <TextBlock Text="Default Shift" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding ShiftTemplates}" SelectedItem="{Binding DefaultShift}" DisplayMemberPath="Name" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Grace Period (Minutes)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding GracePeriodMinutes}" Padding="8" Margin="0,0,0,12"/>

            <CheckBox Content="Eligible for Overtime" IsChecked="{Binding IsOvertimeEligible}" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Step 4: Summary -->
        <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=4}">
            <TextBlock Text="Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding FirstName, StringFormat='Name: {0}'}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding EmployeeCode, StringFormat='Code: {0}'}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SelectedDepartment.Name, StringFormat='Department: {0}'}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SelectedPosition.Name, StringFormat='Position: {0}'}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding DefaultShift.Name, StringFormat='Shift: {0}'}" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" Padding="16,8" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="2" Content="Back" Command="{Binding PreviousCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource InequalityToVisibilityConverter}, ConverterParameter=1}" Padding="16,8" Background="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="4" Content="Next" Command="{Binding NextCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource InequalityToVisibilityConverter}, ConverterParameter=4}" Padding="16,8" Background="{DynamicResource PrimaryColor}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="4" Content="Save" Command="{Binding SaveCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=4}" Padding="16,8" Background="#1E8E3E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
