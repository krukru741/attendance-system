<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================
         Typography — Inter font family (embedded)
         ===================================================== -->

    <!-- Font Families -->
    <FontFamily x:Key="FontInter">pack://application:,,,/BiometricAttendance.App;component/Resources/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontFallback">Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeXs">10</sys:Double>
    <sys:Double x:Key="FontSizeSm">12</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeMd">15</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXl">18</sys:Double>
    <sys:Double x:Key="FontSize2xl">22</sys:Double>
    <sys:Double x:Key="FontSize3xl">28</sys:Double>
    <sys:Double x:Key="FontSize4xl">36</sys:Double>

    <!-- Base Typography Style -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBase}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Heading Styles -->
    <Style x:Key="TextH1" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource FontSize3xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TextH2" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource FontSize2xl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TextH3" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource FontSizeXl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TextH4" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource FontSizeLg}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Body Styles -->
    <Style x:Key="TextBody" BasedOn="{StaticResource TextBase}" TargetType="TextBlock"/>

    <Style x:Key="TextBodySm" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    </Style>

    <Style x:Key="TextMuted" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeSm}"/>
    </Style>

    <Style x:Key="TextCaption" BasedOn="{StaticResource TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource FontSizeXs}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Global default TextBlock style -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}"/>

</ResourceDictionary>
