<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush"          Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"     Color="{StaticResource ColorPrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"      Color="{StaticResource ColorPrimaryDark}"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentDarkBrush"       Color="{StaticResource ColorAccentDark}"/>

    <!-- Background / Surface -->
    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="SidebarBrush"          Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"     Color="{StaticResource ColorSidebarHover}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"    Color="{StaticResource ColorSidebarActive}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"             Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="TextLightBrush"        Color="{StaticResource ColorTextLight}"/>
    <SolidColorBrush x:Key="MutedBrush"            Color="{StaticResource ColorMuted}"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="InfoBrush"             Color="{StaticResource ColorInfo}"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BorderFocusBrush"      Color="{StaticResource ColorBorderFocus}"/>

    <!-- Input -->
    <SolidColorBrush x:Key="InputBgBrush"          Color="{StaticResource ColorInputBg}"/>
    <SolidColorBrush x:Key="InputDisabledBrush"    Color="{StaticResource ColorInputDisabled}"/>

    <!-- Semi-transparent overlays -->
    <SolidColorBrush x:Key="OverlayBrush"          Color="#80000000"/>
    <SolidColorBrush x:Key="CardShadowBrush"       Color="#1A000000"/>

</ResourceDictionary>
