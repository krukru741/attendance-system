<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         Brand Color Palette  (01-UI-UX-STRUCTURE.md §4)
         ===================================================== -->

    <!-- Primary: Clay Brown -->
    <Color x:Key="ColorPrimary">#6B352A</Color>
    <Color x:Key="ColorPrimaryLight">#8C5045</Color>
    <Color x:Key="ColorPrimaryDark">#4E251C</Color>

    <!-- Accent: Soft Butter -->
    <Color x:Key="ColorAccent">#FFF1A6</Color>
    <Color x:Key="ColorAccentDark">#E8D580</Color>

    <!-- Backgrounds -->
    <Color x:Key="ColorBackground">#F8F7F4</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSidebarBg">#3D1F17</Color>
    <Color x:Key="ColorSidebarHover">#6B352A</Color>
    <Color x:Key="ColorSidebarActive">#8C5045</Color>

    <!-- Text -->
    <Color x:Key="ColorText">#292522</Color>
    <Color x:Key="ColorTextLight">#FFFFFF</Color>
    <Color x:Key="ColorMuted">#77716C</Color>

    <!-- Semantic -->
    <Color x:Key="ColorSuccess">#3F7D58</Color>
    <Color x:Key="ColorWarning">#C58A24</Color>
    <Color x:Key="ColorDanger">#B94A48</Color>
    <Color x:Key="ColorInfo">#3A6FA8</Color>

    <!-- Borders / Dividers -->
    <Color x:Key="ColorBorder">#E0DDD8</Color>
    <Color x:Key="ColorBorderFocus">#6B352A</Color>

    <!-- Input -->
    <Color x:Key="ColorInputBg">#FFFFFF</Color>
    <Color x:Key="ColorInputDisabled">#F0EDEA</Color>

</ResourceDictionary>
